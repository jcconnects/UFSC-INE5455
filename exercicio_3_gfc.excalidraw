      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "dll7gKPHqn8efO8TAIuoi",
      "originalText": "self.board.put_tile(tile, self.line_of_empty_position, self.column_of_empty_position)\nself.dic_positions_of_tiles.update({tile: (self.line_of_empty_position, self.column_of_empty_position)})\nself.line_of_empty_position = tile_line\nself.column_of_empty_position = tile_column\nself.board.put_tile(None, self.line_of_empty_position, self.column_of_empty_position)\nreturn True",
